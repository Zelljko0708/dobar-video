* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 20px;
  background: #101522;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  text-align: center;
  padding: 25px 10px;
  background: #202b42;
  border-radius: 15px;
}

h1 {
  color: #aab7ff;
}

main {
  max-width: 600px;
  margin: auto;
}

section {
  background: #202b42;
  padding: 20px;
  margin-top: 20px;
  border-radius: 15px;
}

input {
  width: 100%;
  padding: 13px;
  border-radius: 10px;
  border: none;
  margin-top: 10px;
}

video {
  width: 100%;
  max-height: 450px;
  margin-top: 15px;
}

h3 {
  color: #aab7ff;
}
